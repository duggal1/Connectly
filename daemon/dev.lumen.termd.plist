<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>dev.lumen.termd</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/termd</string>
    <string>--listen</string><string>100.x.y.z:7681</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>/Users/YOU</string>
    <key>SHELL</key><string>/bin/zsh</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardErrorPath</key><string>/Users/YOU/Library/Logs/termd.log</string>
  <key>StandardOutPath</key><string>/Users/YOU/Library/Logs/termd.log</string>
</dict>
</plist>